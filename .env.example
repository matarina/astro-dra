# Keep this deployment isolated from any existing Astro DRA project.
ASTRO_DRA_IMAGE=astro-dra:transfer-20261022
LDR_BIND_ADDRESS=127.0.0.1
LDR_PORT=5001
TZ=Asia/Shanghai

# Configure an OpenAI-compatible model endpoint before starting the app.
LDR_LLM_OPENAI_ENDPOINT_URL=https://your-provider.example/v1
LDR_LLM_OPENAI_ENDPOINT_API_KEY=
LDR_LLM_MODEL=your-model-name
# Optional explicit proxy for PubMed/Europe PMC search traffic; keep LLM proxy settings separate.
# If the proxy requires authentication, provide the credentialed URL through a
# private deployment environment rather than committing it here. If it only
# listens on host loopback, expose a Docker-reachable relay (for example
# `deployment/proxy_relay.py --port 2088`) before starting the stack.
LDR_SEARCH_PROXY_URL=
LDR_LANGGRAPH_AGENT_MAX_UNIQUE_SOURCES=500
# Optional container path. The app checks /data/journal_data/jcr.db by default.
LDR_JCR_CATALOG_PATH=
# Saving-time per-citation QC stays off; native LDR fact consistency remains on.
LDR_VERIFY_ENABLE_CITATION_QC=false

# Replaced with a randomly generated value by transfer/prepare_env.py.
SEARXNG_SECRET=replace-with-a-random-secret
