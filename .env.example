# Copy to .env at the repository root. No production credentials belong here.
ASTRO_DRA_IMAGE=astro-dra:local
LDR_BIND_ADDRESS=127.0.0.1
LDR_PORT=5000
TZ=Asia/Shanghai
LDR_LLM_PROVIDER=openai_endpoint
LDR_LLM_OPENAI_ENDPOINT_URL=https://your-provider.example/v1
LDR_LLM_OPENAI_ENDPOINT_API_KEY=
LDR_LLM_MODEL=your-model-name
# Optional official DeepSeek backend; provider DeepSeek, model deepseek-flash.
LDR_LLM_DEEPSEEK_API_KEY=
# Optional private diagnostics: drafts, selected evidence, review, writer, citation map.
LDR_RESEARCH_TRACE_ENABLED=false
# Optional additional base model; choose llama.cpp on the research form.
LDR_LLM_LLAMACPP_URL=http://localhost:8080/v1
LDR_LLM_LLAMACPP_API_KEY=
# Generate with: python -c 'import secrets; print(secrets.token_hex(32))'
SEARXNG_SECRET=replace-with-a-random-secret
LDR_SEARCH_ENGINE_WEB_PUBMED_API_KEY=
LDR_VERIFY_CROSSREF_MAILTO=ldr-research-verify@example.com
LDR_VERIFY_ENABLE_VERIFY=true
LDR_VERIFY_ENABLE_CITATION_QC=false
LDR_GENERAL_ENABLE_FACT_CHECKING=true
LDR_LANGGRAPH_AGENT_MAX_UNIQUE_SOURCES=500
LDR_APP_ALLOW_REGISTRATIONS=true
LDR_ENABLE_FILE_LOGGING=true
# Project proxy port: 9876. Include your private LLM hostname/IP in LDR_NO_PROXY.
# If the host proxy listens only on 127.0.0.1, enable COMPOSE_PROFILES=loopback-proxy.
LDR_HTTP_PROXY=http://host.docker.internal:9876
LDR_HTTPS_PROXY=http://host.docker.internal:9876
LDR_NO_PROXY=localhost,127.0.0.1,::1,host.docker.internal,searxng

# The root Compose fixes automatic/Agent sources to PubMed, SearXNG, Europe PMC.
# Other native sources and Library automatic selection are disabled there.
# SearXNG uses only Bing; change deployment/searxng/settings.yml to expand it.
# Restore 5000's bounded candidate counts, and explicitly enable engine filters.
LDR_SEARCH_TOOL=searxng
LDR_SEARCH_SKIP_RELEVANCE_FILTER=false
LDR_SEARCH_MAX_RESULTS=12
LDR_SEARCH_MAX_FILTERED_RESULTS=6

# Optional loopback-proxy relay: use the host proxy owner (id -u / id -g).
# Pin its image independently when application images change.
PROXY_RELAY_UID=1000
PROXY_RELAY_GID=1000
# PROXY_RELAY_IMAGE=astro-dra:local
